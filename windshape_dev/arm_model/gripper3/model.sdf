<?xml version="1.0"?>
<sdf version="1.9">
  <model name="gripper3">
    <static>false</static>
    <self_collide>false</self_collide>

    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0.022563 0.018368 -0.0176 0 0 0</pose>
        <mass>0.085138</mass>
        <inertia>
          <ixx>1.5815e-05</ixx>
          <ixy>5.4955e-07</ixy>
          <ixz>-7.279e-07</ixz>
          <iyy>2.219e-05</iyy>
          <iyz>2.9639e-06</iyz>
          <izz>2.4841e-05</izz>
        </inertia>
      </inertial>

      <collision name="base_link_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://gripper3/meshes/base_link.STL</uri>
          </mesh>
        </geometry>
      </collision>

      <visual name="base_link_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://gripper3/meshes/base_link.STL</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <link name="Empty_Link1">
      <pose>0.04 0 0.02 1.5708 0.90665 0</pose>
      <inertial>
        <pose>-0.021122 0.028354 -0.005583 0 0 0</pose>
        <mass>0.1</mass>
        <inertia>
          <ixx>1.1931e-05</ixx>
          <ixy>8.7376e-06</ixy>
          <ixz>-1.3248e-16</ixz>
          <iyy>8.789e-06</iyy>
          <iyz>-2.1751e-17</iyz>
          <izz>2.0324e-05</izz>
        </inertia>
      </inertial>

      <collision name="Empty_Link1_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://gripper3/meshes/Empty_Link1.STL</uri>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="Empty_Link1_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://gripper3/meshes/Empty_Link1.STL</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <joint name="joint1" type="revolute">
      <parent>base_link</parent>
      <child>Empty_Link1</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.5</lower>
          <upper>2.0</upper>
          <effort>2.0</effort>
          <velocity>1.0</velocity>
        </limit>
        <dynamics>
          <damping>0.01</damping>
          <friction>0</friction>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>

    <link name="Empty_Link2">
      <pose>0.012 0 0.0195 -1.5708 0.96069 3.14159</pose>
      <inertial>
        <pose>-0.019265 -0.025888 -0.004777 0 0 0</pose>
        <mass>0.1</mass>
        <inertia>
          <ixx>1.6519e-06</ixx>
          <ixy>-1.216e-06</ixy>
          <ixz>-7.2546e-17</ixz>
          <iyy>1.5595e-06</iyy>
          <iyz>-3.2073e-16</iyz>
          <izz>2.886e-06</izz>
        </inertia>
      </inertial>

      <collision name="Empty_Link2_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://gripper3/meshes/Empty_Link2.STL</uri>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="Empty_Link2_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://gripper3/meshes/Empty_Link2.STL</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <joint name="joint2" type="revolute">
      <parent>base_link</parent>
      <child>Empty_Link2</child>
      <axis>
        <xyz>0 0 -1</xyz>
        <limit>
          <lower>-0.5</lower>
          <upper>2.0</upper>
          <effort>2.0</effort>
          <velocity>1.0</velocity>
        </limit>
        <dynamics>
          <damping>0.01</damping>
          <friction>0</friction>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>

    <!-- Gazebo Sim / ROS 2 Humble: joint position control for finger 1 -->
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>joint1</joint_name>
      <joint_index>0</joint_index>
      <topic>/joint/gripper3/position_cmd</topic>
      <p_gain>2.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>0.05</d_gain>
      <i_max>0.0</i_max>
      <i_min>0.0</i_min>
      <cmd_max>2.0</cmd_max>
      <cmd_min>-2.0</cmd_min>
      <initial_position>0.0</initial_position>
    </plugin>

    <!-- Gazebo Sim / ROS 2 Humble: joint position control for finger 2.
         joint2 axis is 0 0 -1, so using the same target angle as joint1 produces symmetric motion. -->
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>joint2</joint_name>
      <joint_index>0</joint_index>
      <topic>/joint/gripper3/position_cmd</topic>
      <p_gain>2.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>0.05</d_gain>
      <i_max>0.0</i_max>
      <i_min>0.0</i_min>
      <cmd_max>2.0</cmd_max>
      <cmd_min>-2.0</cmd_min>
      <initial_position>0.0</initial_position>
    </plugin>

    <!-- Publish only gripper3 joint states -->
    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <topic>/gripper3/joint_state</topic>
      <joint_name>joint1</joint_name>
      <joint_name>joint2</joint_name>
    </plugin>

  </model>
</sdf>