  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background: #07120f;
}

#centralwidget {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #07120f,
                                stop:0.46 #0e201d,
                                stop:1 #16251a);
}

QTabWidget::pane {
    border: 0;
    background: transparent;
}

QTabBar::tab {
    min-width: 130px;
    padding: 10px 20px;
    margin-right: 8px;
    border-radius: 16px;
    color: #9fb6ac;
    background: rgba(255, 255, 255, 24);
    font: 700 10pt "DejaVu Sans";
}

QTabBar::tab:selected {
    color: #07120f;
    background: #d6f36f;
}

#heroPanel {
    border-radius: 28px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #d6f36f,
                                stop:0.52 #8ed9b6,
                                stop:1 #5bc3d6);
}

#heroTitle {
    color: #07120f;
    font: 900 27pt "DejaVu Sans";
    letter-spacing: 1px;
}

#heroSubtitle {
    color: #173028;
    font: 600 11pt "DejaVu Sans";
}

#statusPill {
    color: #d6f36f;
    background: #07120f;
    border: 1px solid rgba(214, 243, 111, 150);
    border-radius: 18px;
    padding: 8px 14px;
    font: 800 10pt "DejaVu Sans";
}

#groupBox_12 {
    border: 1px solid rgba(214, 243, 111, 72);
    border-radius: 28px;
    margin-top: 20px;
    padding: 28px 24px 24px 24px;
    background: rgba(7, 18, 15, 190);
    color: #ecf8d8;
    font: 900 13pt "DejaVu Sans";
}

#groupBox_12::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 22px;
    padding: 0 12px;
    color: #d6f36f;
    background: #07120f;
}

QFrame[panelRole="controlCard"] {
    border: 1px solid rgba(255, 255, 255, 38);
    border-radius: 22px;
    background: rgba(255, 255, 255, 18);
}

QFrame[panelRole="controlCard"]:hover {
    border: 1px solid rgba(214, 243, 111, 150);
    background: rgba(214, 243, 111, 28);
}

QLabel[role="eyebrow"] {
    color: #91a79e;
    font: 800 8pt "DejaVu Sans";
    letter-spacing: 1px;
}

QLabel[role="channelTitle"] {
    color: #f1f6e8;
    font: 900 13pt "DejaVu Sans";
}

QLabel[role="channelHint"] {
    color: #9fb6ac;
    font: 600 9pt "DejaVu Sans";
}

QComboBox {
    min-height: 38px;
    padding: 6px 14px;
    border-radius: 15px;
    border: 1px solid rgba(214, 243, 111, 90);
    color: #f7ffe9;
    background: rgba(3, 11, 9, 210);
    font: 800 10pt "DejaVu Sans";
}

QComboBox:hover {
    border: 1px solid #d6f36f;
}

QComboBox::drop-down {
    border: 0;
    width: 28px;
}

QComboBox QAbstractItemView {
    selection-background-color: #d6f36f;
    selection-color: #07120f;
    color: #f7ffe9;
    background: #0b1815;
    border: 1px solid #d6f36f;
    outline: 0;
}

QLCDNumber {
    min-height: 42px;
    border: 1px solid rgba(91, 195, 214, 130);
    border-radius: 14px;
    color: #5bc3d6;
    background: rgba(0, 0, 0, 115);
}

QPushButton {
    min-height: 52px;
    border: 0;
    border-radius: 20px;
    padding: 8px 24px;
    font: 900 13pt "DejaVu Sans";
}

#button_connect {
    color: #07120f;
    background: #d6f36f;
}

#button_connect:hover {
    background: #eaff8f;
}

#button_connect:disabled {
    color: rgba(7, 18, 15, 120);
    background: rgba(214, 243, 111, 95);
}

#quit_button {
    color: #f8e7d4;
    background: rgba(214, 95, 75, 210);
}

#quit_button:hover {
    background: #eb755d;
}

QMenuBar {
    color: #cbd9d2;
    background: #07120f;
}

QMenuBar::item:selected, QMenu::item:selected {
    color: #07120f;
    background: #d6f36f;
}

QMenu {
    color: #ecf8d8;
    background: #0b1815;
    border: 1px solid rgba(214, 243, 111, 80);
}

QStatusBar {
    color: #9fb6ac;
    background: #07120f;
}</string>
