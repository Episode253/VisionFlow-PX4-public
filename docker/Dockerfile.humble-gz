FROM osrf/ros:humble-desktop-full

# Override BuildKit's predefined proxy args to prevent routing through unavailable proxy.
# Setting them empty disables proxy for all RUN commands in this build.
ARG http_proxy=
ARG https_proxy=
ARG ftp_proxy=
ARG FTP_PROXY=
ARG no_proxy=
ARG NO_PROXY=

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=humble
ENV AMENT_TRACE_SETUP_FILES=
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# Replace Ubuntu sources with Aliyun mirror for better CN accessibility.
# Keeps working for international users (modern apt will fallback if needed).
RUN sed -i 's|http://archive.ubuntu.com|http://mirrors.aliyun.com|g' /etc/apt/sources.list && \
    sed -i 's|http://security.ubuntu.com|http://mirrors.aliyun.com|g' /etc/apt/sources.list

# Replace ROS2 sources with official CN mirror
RUN sed -i 's|packages.ros.org|mirrors.aliyun.com/ros2|g' /etc/apt/sources.list.d/ros2*.list 2>/dev/null || true

# Enable Ubuntu universe repository, needed by some PX4/NuttX packages.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    gnupg \
    gosu \
    lsb-release \
    software-properties-common \
    sudo \
    wget \
    curl \
    && add-apt-repository -y universe \
    && rm -rf /var/lib/apt/lists/*

# PX4 general dependencies, aligned with Tools/setup/ubuntu.sh.
# Note: CI-only tools (astyle/cppcheck/lcov/shellcheck) are intentionally
# omitted here; they are used by `make check_format`/coverage in CI, never by
# a firmware or SITL build. Re-add them if you run those targets locally.
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash-completion \
    build-essential \
    ccache \
    cmake \
    file \
    g++ \
    gcc \
    gdb \
    git \
    libssl-dev \
    libxml2-dev \
    libxml2-utils \
    libxslt1-dev \
    make \
    ninja-build \
    pkg-config \
    python3 \
    python3-dev \
    python3-pip \
    python3-setuptools \
    python3-wheel \
    python3-venv \
    python3-colcon-common-extensions \
    python3-rosdep \
    python3-vcstool \
    python3-empy \
    python3-toml \
    python3-numpy \
    python3-yaml \
    python3-jinja2 \
    python3-packaging \
    python3-jsonschema \
    python3-pandas \
    python3-pytest \
    python3-serial \
    python3-kconfiglib \
    rsync \
    unzip \
    zip \
    && rm -rf /var/lib/apt/lists/*

# PX4 NuttX dependencies, aligned with official ubuntu.sh.
RUN apt-get update && apt-get install -y --no-install-recommends \
    automake \
    binutils-dev \
    bison \
    clang \
    flex \
    gdb-multiarch \
    genromfs \
    gettext \
    gperf \
    kconfig-frontends \
    libelf-dev \
    libexpat-dev \
    libgmp-dev \
    libisl-dev \
    libmpc-dev \
    libmpfr-dev \
    libncurses-dev \
    libncurses6 \
    libncursesw6 \
    libnewlib-arm-none-eabi \
    libstdc++-arm-none-eabi-newlib \
    libtool \
    libunwind-dev \
    lld \
    lldb \
    screen \
    texinfo \
    u-boot-tools \
    util-linux \
    vim-common \
    && rm -rf /var/lib/apt/lists/*

# Architecture-specific NuttX toolchain dependencies.
ARG INSTALL_XTENSA_ESP=0
RUN set -eux; \
    ARCH="$(uname -m)"; \
    if [ "${ARCH}" = "x86_64" ]; then \
        apt-get update; \
        apt-get install -y --no-install-recommends \
            g++-multilib \
            gcc-arm-none-eabi \
            gcc-multilib; \
        if apt-cache show esptool >/dev/null 2>&1; then \
            apt-get install -y --no-install-recommends esptool; \
        else \
            python3 -m pip install --no-cache-dir esptool; \
        fi; \
        rm -rf /var/lib/apt/lists/*; \
        if [ "${INSTALL_XTENSA_ESP}" = "1" ]; then \
            XTENSA_FILE_NAME="xtensa-esp-elf-13.2.0_20240530-x86_64-linux-gnu.tar.xz"; \
            wget --progress=dot:giga --tries=3 --timeout=30 -P /tmp "https://github.com/espressif/crosstool-NG/releases/download/esp-13.2.0_20240530/${XTENSA_FILE_NAME}"; \
            tar -xf "/tmp/${XTENSA_FILE_NAME}" -C /opt; \
            rm "/tmp/${XTENSA_FILE_NAME}"; \
        else \
            echo "Skipping optional Xtensa ESP compiler download. Set INSTALL_XTENSA_ESP=1 if needed."; \
        fi; \
    elif [ "${ARCH}" = "aarch64" ]; then \
        apt-get update; \
        apt-get install -y --no-install-recommends \
            g++-aarch64-linux-gnu \
            g++-arm-linux-gnueabihf; \
        rm -rf /var/lib/apt/lists/*; \
    fi

ENV PATH="/opt/xtensa-esp-elf/bin:${PATH}"

# Configure Gazebo repository.
# Add source list entry with allow-insecure=yes to skip signature verification if key fetch fails.
RUN (curl -sSL https://packages.osrfoundation.org/gazebo.gpg -o /usr/share/keyrings/pkgs-osrf-archive-keyring.gpg 2>/dev/null) || true && \
    echo "deb [arch=$(dpkg --print-architecture) allow-insecure=yes signed-by=/usr/share/keyrings/pkgs-osrf-archive-keyring.gpg] http://packages.osrfoundation.org/gazebo/ubuntu-stable $(lsb_release -cs) main" \
    > /etc/apt/sources.list.d/gazebo-stable.list

# PX4 simulation dependencies, aligned with official ubuntu.sh.
RUN apt-get update && apt-get install -y --allow-unauthenticated --no-install-recommends \
    bc \
    dmidecode \
    gz-harmonic \
    libeigen3-dev \
    libgstreamer-plugins-base1.0-dev \
    libgstreamer-plugins-bad1.0-dev \
    libgstreamer1.0-dev \
    libgstrtspserver-1.0-dev \
    libimage-exiftool-perl \
    libopencv-dev \
    libprotobuf-dev \
    libtinyxml2-dev \
    libasio-dev \
    libbullet-dev \
    libgl1-mesa-dri \
    libglx-mesa0 \
    libglu1-mesa \
    mesa-utils \
    x11-apps \
    dbus-x11 \
    protobuf-compiler \
    geographiclib-tools \
    gstreamer1.0-tools \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-plugins-ugly \
    gstreamer1.0-libav \
    ros-humble-rosbridge-server \
    ros-humble-rosbridge-suite \
    ros-humble-std-msgs \
    ros-humble-sensor-msgs \
    ros-humble-trajectory-msgs \
    ros-humble-joint-state-publisher \
    ros-humble-robot-state-publisher \
    ros-humble-kdl-parser \
    liborocos-kdl-dev \
    iproute2 \
    net-tools \
    lsof \
    procps \
    xdg-utils \
    tmux \
    && if [ "$(lsb_release -rs)" = "24.04" ]; then apt-get install -y --allow-unauthenticated --no-install-recommends cppzmq-dev; fi \
    && rm -rf /var/lib/apt/lists/*

# Embedded Gamma Arm Web Control GUI dependencies.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnss3 \
    libxss1 \
    libasound2 \
    libatk-bridge2.0-0 \
    libgtk-3-0 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    libxkbcommon-x11-0 \
    libxcb-cursor0 \
    libxcb-icccm4 \
    libxcb-image0 \
    libxcb-keysyms1 \
    libxcb-render-util0 \
    libxcb-xinerama0 \
    libxcb-xinput0 \
    libxcb-xfixes0 \
    libxcb-shape0 \
    libxcb-randr0 \
    libxcb-render0 \
    libxcb-sync1 \
    libxcb-xkb1 \
    fonts-dejavu-core \
    fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

# Flight Review system dependencies.
RUN apt-get update && apt-get install -y --no-install-recommends \
    sqlite3 \
    libfftw3-bin \
    libfftw3-dev \
    libatlas3-base \
    && rm -rf /var/lib/apt/lists/*

# PX4 Python dependencies.
COPY Tools/setup/requirements.txt /tmp/px4-requirements.txt

# Use Aliyun PyPI mirror for faster Python package downloads in CN
RUN python3 -m pip install -i https://mirrors.aliyun.com/pypi/simple/ --no-cache-dir -r /tmp/px4-requirements.txt && \
    python3 -m pip install -i https://mirrors.aliyun.com/pypi/simple/ --no-cache-dir \
        MAVProxy \
        pymavlink \
        PySide6

# Flight Review Python dependencies.
COPY windshape_dev/flight_review/app/requirements.txt /tmp/flight_review_requirements.txt

RUN python3 -m venv /opt/flight_review_venv && \
    /opt/flight_review_venv/bin/python -m pip install -i https://mirrors.aliyun.com/pypi/simple/ --no-cache-dir --upgrade pip setuptools wheel && \
    /opt/flight_review_venv/bin/pip install -i https://mirrors.aliyun.com/pypi/simple/ --no-cache-dir -r /tmp/flight_review_requirements.txt

ENV FLIGHT_REVIEW_VENV=/opt/flight_review_venv

ARG USERNAME=px4
ARG USER_UID=1000
ARG USER_GID=1000

RUN groupadd --gid ${USER_GID} ${USERNAME} || true && \
    useradd --uid ${USER_UID} --gid ${USER_GID} -m ${USERNAME} -s /bin/bash || true && \
    echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/${USERNAME} && \
    chmod 0440 /etc/sudoers.d/${USERNAME}

RUN mkdir -p \
    /workspace \
    /home/${USERNAME}/.ccache \
    /home/${USERNAME}/.gz \
    /home/${USERNAME}/.gz/sim \
    /home/${USERNAME}/.gz/sim/8 && \
    chown -R ${USER_UID}:${USER_GID} /workspace /home/${USERNAME} /opt/flight_review_venv

RUN usermod -aG dialout ${USERNAME} || true

COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

USER ${USERNAME}
WORKDIR /workspace/VisionFlow-PX4

ENV CCACHE_DIR=/home/${USERNAME}/.ccache
ENV QT_X11_NO_MITSHM=1
ENV QTWEBENGINE_DISABLE_SANDBOX=1
ENV QTWEBENGINE_CHROMIUM_FLAGS="--no-sandbox --disable-gpu --disable-dev-shm-usage"
ENV XDG_RUNTIME_DIR=/tmp/runtime-${USERNAME}
ENV LIBGL_ALWAYS_SOFTWARE=0

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
