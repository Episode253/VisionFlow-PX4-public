FROM osrf/ros:humble-desktop-full

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=humble
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# Enable Ubuntu universe repository, needed by some PX4/NuttX packages.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    gnupg \
    gosu \
    lsb-release \
    software-properties-common \
    sudo \
    wget \
    curl \
    && add-apt-repository -y universe \
    && rm -rf /var/lib/apt/lists/*

# PX4 general dependencies, aligned with Tools/setup/ubuntu.sh.
RUN apt-get update && apt-get install -y --no-install-recommends \
    astyle \
    bash-completion \
    build-essential \
    ccache \
    cmake \
    cppcheck \
    file \
    g++ \
    gcc \
    gdb \
    git \
    lcov \
    libssl-dev \
    libxml2-dev \
    libxml2-utils \
    libxslt1-dev \
    make \
    ninja-build \
    pkg-config \
    python3 \
    python3-dev \
    python3-pip \
    python3-setuptools \
    python3-wheel \
    python3-venv \
    python3-colcon-common-extensions \
    python3-rosdep \
    python3-vcstool \
    python3-empy \
    python3-toml \
    python3-numpy \
    python3-yaml \
    python3-jinja2 \
    python3-packaging \
    python3-jsonschema \
    python3-pandas \
    python3-pytest \
    python3-serial \
    python3-kconfiglib \
    rsync \
    shellcheck \
    unzip \
    zip \
    && rm -rf /var/lib/apt/lists/*

# PX4 NuttX dependencies, aligned with official ubuntu.sh.
RUN apt-get update && apt-get install -y --no-install-recommends \
    automake \
    binutils-dev \
    bison \
    build-essential \
    clang \
    clang-tidy \
    clang-format \
    flex \
    gdb-multiarch \
    genromfs \
    gettext \
    gperf \
    kconfig-frontends \
    libelf-dev \
    libexpat-dev \
    libgmp-dev \
    libisl-dev \
    libmpc-dev \
    libmpfr-dev \
    libncurses-dev \
    libncurses6 \
    libncursesw6 \
    libnewlib-arm-none-eabi \
    libstdc++-arm-none-eabi-newlib \
    libtool \
    libunwind-dev \
    lld \
    lldb \
    screen \
    texinfo \
    u-boot-tools \
    util-linux \
    vim-common \
    && rm -rf /var/lib/apt/lists/*

# Architecture-specific NuttX toolchain dependencies.
# For normal x86_64/amd64 development machines, install arm-none-eabi,
# multilib support, esptool, and Xtensa ESP compiler.
RUN set -eux; \
    ARCH="$(uname -m)"; \
    if [ "${ARCH}" = "x86_64" ]; then \
        apt-get update; \
        apt-get install -y --no-install-recommends \
            g++-multilib \
            gcc-arm-none-eabi \
            gcc-multilib; \
        if apt-cache show esptool >/dev/null 2>&1; then \
            apt-get install -y --no-install-recommends esptool; \
        else \
            python3 -m pip install --no-cache-dir esptool; \
        fi; \
        rm -rf /var/lib/apt/lists/*; \
        XTENSA_FILE_NAME="xtensa-esp-elf-13.2.0_20240530-x86_64-linux-gnu.tar.xz"; \
        wget -q -P /tmp "https://github.com/espressif/crosstool-NG/releases/download/esp-13.2.0_20240530/${XTENSA_FILE_NAME}"; \
        tar -xf "/tmp/${XTENSA_FILE_NAME}" -C /opt; \
        rm "/tmp/${XTENSA_FILE_NAME}"; \
    elif [ "${ARCH}" = "aarch64" ]; then \
        apt-get update; \
        apt-get install -y --no-install-recommends \
            g++-aarch64-linux-gnu \
            g++-arm-linux-gnueabihf; \
        rm -rf /var/lib/apt/lists/*; \
    fi

ENV PATH="/opt/xtensa-esp-elf/bin:${PATH}"

# Gazebo Harmonic official repository.
RUN curl -sSL https://packages.osrfoundation.org/gazebo.gpg \
    -o /usr/share/keyrings/pkgs-osrf-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/pkgs-osrf-archive-keyring.gpg] http://packages.osrfoundation.org/gazebo/ubuntu-stable $(lsb_release -cs) main" \
    > /etc/apt/sources.list.d/gazebo-stable.list

# PX4 simulation dependencies, aligned with official ubuntu.sh.
RUN apt-get update && apt-get install -y --no-install-recommends \
    bc \
    dmidecode \
    gz-harmonic \
    libunwind-dev \
    libeigen3-dev \
    libgstreamer-plugins-base1.0-dev \
    libgstreamer-plugins-bad1.0-dev \
    libgstreamer1.0-dev \
    libgstrtspserver-1.0-dev \
    libimage-exiftool-perl \
    libopencv-dev \
    libprotobuf-dev \
    libtinyxml2-dev \
    libasio-dev \
    libbullet-dev \
    libgl1-mesa-dri \
    libglx-mesa0 \
    libglu1-mesa \
    mesa-utils \
    x11-apps \
    dbus-x11 \
    protobuf-compiler \
    geographiclib-tools \
    gstreamer1.0-tools \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-plugins-ugly \
    gstreamer1.0-libav \
    ros-humble-ros-gzharmonic \
    && if [ "$(lsb_release -rs)" = "24.04" ]; then apt-get install -y --no-install-recommends cppzmq-dev; fi \
    && rm -rf /var/lib/apt/lists/*

# PX4 Python dependencies.
COPY Tools/setup/requirements.txt /tmp/px4-requirements.txt

RUN python3 -m pip install --no-cache-dir -r /tmp/px4-requirements.txt && \
    python3 -m pip install --no-cache-dir \
        MAVProxy \
        pymavlink

ARG USERNAME=px4
ARG USER_UID=1000
ARG USER_GID=1000

RUN groupadd --gid ${USER_GID} ${USERNAME} || true && \
    useradd --uid ${USER_UID} --gid ${USER_GID} -m ${USERNAME} -s /bin/bash || true && \
    echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/${USERNAME} && \
    chmod 0440 /etc/sudoers.d/${USERNAME}

RUN mkdir -p \
    /workspace \
    /home/${USERNAME}/.ccache \
    /home/${USERNAME}/.gz \
    /home/${USERNAME}/.gz/sim \
    /home/${USERNAME}/.gz/sim/8 && \
    chown -R ${USER_UID}:${USER_GID} /workspace /home/${USERNAME}

RUN usermod -aG dialout ${USERNAME} || true

COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

USER ${USERNAME}
WORKDIR /workspace/VisionFlow-PX4

ENV CCACHE_DIR=/home/${USERNAME}/.ccache
ENV QT_X11_NO_MITSHM=1
ENV LIBGL_ALWAYS_SOFTWARE=0

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
