<?xml version="1.0"?>
<sdf version="1.9">
  <model name="q940_ti_gripper4">
    <static>false</static>
    <self_collide>false</self_collide>
    <enable_wind>false</enable_wind>

    <include merge="true">
      <uri>model://q940</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <include>
      <name>ti5_arm</name>
      <uri>model://ti5_arm</uri>
      <pose>0 0 0 3.14159 0 -1.5708</pose>
    </include>

    <joint name="q940_ti_joint" type="fixed">
      <parent>base_link</parent>
      <child>ti5_arm::ti5_arm_base_link</child>
    </joint>

    <include>
      <name>gripper4</name>
      <uri>model://gripper4</uri>
      <pose relative_to="ti5_arm::F_Link">-0.002 0 -0.030 -3.14159 0 0</pose>
    </include>

    <joint name="ti5_gripper_joint" type="fixed">
      <parent>ti5_arm::F_Link</parent>
      <child>gripper4::base_link</child>
    </joint>

    <!-- OakD-Lite camera One mounted on UAV body -->
    <include>
      <name>oakd_lite_one</name>
      <uri>model://OakD-lite</uri>
      <pose relative_to="base_link">0.10 0.028 0.06 0 0.785398 0</pose>
    </include>

    <joint name="base_oakd_lite_one_joint" type="fixed">
      <parent>base_link</parent>
      <child>oakd_lite_one::camera_link</child>
    </joint>

    <!-- OakD-Lite camera Two mounted on UAV body -->
    <include>
      <name>oakd_lite_two</name>
      <uri>model://OakD-lite</uri>
      <pose relative_to="base_link">0.10 0.028 0.098 0 0 0</pose>
    </include>

    <joint name="base_oakd_lite_two_joint" type="fixed">
      <parent>base_link</parent>
      <child>oakd_lite_two::camera_link</child>
    </joint>

    <!-- OakD-Lite camera Three mounted on UAV body -->
    <include>
      <name>oakd_lite_three</name>
      <uri>model://OakD-lite</uri>
      <pose relative_to="base_link">0.055 0.028 0 0 1.5708 0</pose>
    </include>

    <joint name="base_oakd_lite_three_joint" type="fixed">
      <parent>base_link</parent>
      <child>oakd_lite_three::camera_link</child>
    </joint>

    <!-- OakD-Lite camera Four mounted on gripper4 body -->
    <include>
      <name>oakd_lite_four</name>
      <uri>model://OakD-lite</uri>
      <pose relative_to="base_link">0.030 -0.023 -0.615 0 1.5708 -1.5708</pose>
    </include>

    <joint name="base_oakd_lite_four_joint" type="fixed">
      <parent>gripper4::base_link</parent>
      <child>oakd_lite_four::camera_link</child>
    </joint>

  </model>
</sdf>
