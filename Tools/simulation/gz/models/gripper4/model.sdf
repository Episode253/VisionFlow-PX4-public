<?xml version="1.0"?>
<sdf version="1.9">
  <model name="gripper4">
    <static>false</static>
    <self_collide>false</self_collide>

    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>

      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.090444</mass>
        <inertia>
          <ixx>3.3873e-05</ixx>
          <ixy>-7.5446e-07</ixy>
          <ixz>4.9143e-07</ixz>
          <iyy>2.568e-05</iyy>
          <iyz>2.0521e-09</iyz>
          <izz>2.1853e-05</izz>
        </inertia>
      </inertial>

      <collision name="base_link_collision">
        <pose>0.023531 0.9743 -0.031805 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://gripper4/meshes/base_link.STL</uri>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="base_link_visual">
        <pose>0.023531 0.9743 -0.031805 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://gripper4/meshes/base_link.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.79216 0.81961 0.93333 1</ambient>
          <diffuse>0.79216 0.81961 0.93333 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="jaw_left">
      <pose>-0.010276 0.02945 0.01063 0 -0.71707 3.1416</pose>

      <inertial>
        <pose>0.028325 0.030931 0.022724 0 0 0</pose>
        <mass>0.035281</mass>
        <inertia>
          <ixx>1.8799e-05</ixx>
          <ixy>1.8575e-07</ixy>
          <ixz>-1.3686e-05</ixz>
          <iyy>3.2532e-05</iyy>
          <iyz>1.7384e-07</iyz>
          <izz>1.5725e-05</izz>
        </inertia>
      </inertial>

      <collision name="jaw_left_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://gripper4/meshes/jaw_left.STL</uri>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="jaw_left_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://gripper4/meshes/jaw_left.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.79216 0.81961 0.93333 1</ambient>
          <diffuse>0.79216 0.81961 0.93333 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="motor_left_jaw" type="revolute">
      <parent>base_link</parent>
      <child>jaw_left</child>

      <axis>
        <xyz>0 1 0</xyz>

        <limit>
          <lower>-0.3</lower>
          <upper>1.5</upper>
          <effort>5.0</effort>
          <velocity>0.8</velocity>
        </limit>

        <dynamics>
          <damping>0.08</damping>
          <friction>0.003</friction>
        </dynamics>
      </axis>
    </joint>

    <link name="jaw_right">
      <pose>0.0141241 0.03196 0.010695 1.5708 0.22743 0</pose>

      <inertial>
        <pose>-0.028325 0.030931 0.022724 0 0 0</pose>
        <mass>0.035281</mass>
        <inertia>
          <ixx>1.8799e-05</ixx>
          <ixy>-1.8575e-07</ixy>
          <ixz>1.3686e-05</ixz>
          <iyy>3.2532e-05</iyy>
          <iyz>-1.7384e-07</iyz>
          <izz>1.5725e-05</izz>
        </inertia>
      </inertial>

      <collision name="jaw_right_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://gripper4/meshes/jaw_right.STL</uri>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="jaw_right_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://gripper4/meshes/jaw_right.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="follow_right_jaw" type="revolute">
      <parent>base_link</parent>
      <child>jaw_right</child>

      <axis>
        <xyz>0 0 -1</xyz>

        <limit>
          <lower>-0.3</lower>
          <upper>1.5</upper>
          <effort>5.0</effort>
          <velocity>0.8</velocity>
        </limit>

        <dynamics>
          <damping>0.08</damping>
          <friction>0.003</friction>
        </dynamics>
      </axis>
    </joint>

    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>motor_left_jaw</joint_name>
      <joint_index>0</joint_index>
      <topic>/joint/gripper4/position_cmd</topic>

      <p_gain>1.2</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>0.15</d_gain>

      <i_max>0.0</i_max>
      <i_min>0.0</i_min>

      <cmd_max>4.0</cmd_max>
      <cmd_min>-4.0</cmd_min>

      <initial_position>0.0</initial_position>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>follow_right_jaw</joint_name>
      <joint_index>0</joint_index>
      <topic>/joint/gripper4/position_cmd</topic>

      <p_gain>1.2</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>0.15</d_gain>

      <i_max>0.0</i_max>
      <i_min>0.0</i_min>

      <cmd_max>4.0</cmd_max>
      <cmd_min>-4.0</cmd_min>

      <initial_position>0.0</initial_position>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/gripper4/joint_state</topic>
      <joint_name>motor_left_jaw</joint_name>
      <joint_name>follow_right_jaw</joint_name>
    </plugin>

  </model>
</sdf>
