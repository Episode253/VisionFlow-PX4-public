    <!-- PX4 HITL bridge: Gazebo Harmonic <-> CUAV X7 Pro -->
    <plugin
      filename="libmavlink_hitl_gazebosim.so"
      name="mavlink_interface::GazeboMavlinkInterface">

      <robotNamespace></robotNamespace>
      <protocol_version>2.0</protocol_version>

      <use_serial>true</use_serial>
      <serial_device>/dev/ttyACM0</serial_device>
      <serial_baudrate>921600</serial_baudrate>

      <qgcUdpForward>true</qgcUdpForward>
      <qgcUdpAddr>127.0.0.1</qgcUdpAddr>
      <qgcUdpRemotePort>14550</qgcUdpRemotePort>
      <qgcUdpLocalPort>14557</qgcUdpLocalPort>

      <enable_lockstep>false</enable_lockstep>
      <useWallTimeForHil>true</useWallTimeForHil>

      <!-- HITL sensor conditioning for current PX4 + Gazebo Harmonic setup -->
      <hilAccelScale>1.0</hilAccelScale>
      <hilGyroScale>1.0</hilGyroScale>
      <hilMagScale>1.0</hilMagScale>
      <hilMagApplyFluToFrd>false</hilMagApplyFluToFrd>
      <hilMagFlipX>false</hilMagFlipX>
      <hilMagFlipY>false</hilMagFlipY>
      <hilMagFlipZ>false</hilMagFlipZ>

      <!-- Velocity safety: keep static bench HITL from injecting impossible GPS / state velocities. -->
      <hilGpsUseVelocity>true</hilGpsUseVelocity>
      <hilGpsMaxSpeed>30.0</hilGpsMaxSpeed>
      <hilSendStateQuaternion>false</hilSendStateQuaternion>

      <motorCount>4</motorCount>
      <fallbackMotorVelocityScaling>1000.0</fallbackMotorVelocityScaling>

      <imuSubTopic>/imu</imuSubTopic>
      <gpsSubTopic>/gps</gpsSubTopic>
      <magSubTopic>/magnetometer</magSubTopic>
      <baroSubTopic>/air_pressure</baroSubTopic>
      <poseSubTopic>/pose/info</poseSubTopic>

      <hilSensorRateHz>100</hilSensorRateHz>
      <hilGpsRateHz>10</hilGpsRateHz>
      <hilStateRateHz>20</hilStateRateHz>
    </plugin>

    <!-- Ground-truth odometry publisher -->
    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_publish_frequency>200</odom_publish_frequency>
      <!-- <odom_topic>/model/q940_ti_0/odometry</odom_topic>
      <odom_covariance_topic>/model/q940_ti_0/odometry_with_covariance</odom_covariance_topic> -->
    </plugin>

  </model>
</sdf>
